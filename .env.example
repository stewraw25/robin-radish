# Canonical site, no trailing slash.
SITE_URL=https://robinandradish.co.uk

# Inbox for the contact page. Leave blank until you have one.
CONTACT_EMAIL=

# Your Awin publisher ID. One ID covers Thompson & Morgan, Crocus and CJ Wildlife.
# Leave blank, or use the placeholder, until you have joined Awin.
AWIN_PUBLISHER_ID=YOUR_AWIN_PUBLISHER_ID

# Optional overrides if a shop is on a different Awin account.
# AWIN_PUBLISHER_ID_THOMPSON_MORGAN=
# AWIN_PUBLISHER_ID_CROCUS=
# AWIN_PUBLISHER_ID_CJ_WILDLIFE=

# Your Webgains campaign ID for Haith's. Confirm the programme is open first.
WEBGAINS_CAMPAIGN_ID=YOUR_WEBGAINS_CAMPAIGN_ID

# UK Amazon Associates tracking ID for Robin & Radish, on the same account as Sleep Better Hub.
# Associates requires every site that uses a tag to be listed on the account.
NEXT_PUBLIC_AMAZON_ASSOCIATE_TAG=robinradish-21
